// ==========================================================================
// firestore.rules — tv-exam Firestore Security Rules
//
// Firebase Console → tv-exam project → Firestore → Rules তে paste করো
// ==========================================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the user logged in?
    function isAuth() {
      return request.auth != null;
    }

    // Helper: is the user an admin?
    // Admin role check → মেইন DB তে user doc থেকে না করে
    // examDb তে একটা admins collection রাখো: admins/{uid}
    function isAdmin() {
      return isAuth() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Helper: is the request from the same user?
    function isSelf(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // ── Exams ──────────────────────────────────────────────────────────────
    // Anyone logged in can read; only admin can write
    match /exams/{examId} {
      allow read: if isAuth();
      allow write: if isAdmin();

      // Questions subcollection
      match /questions/{questionId} {
        allow read: if isAuth();
        allow write: if isAdmin();
      }
    }

    // ── Results ────────────────────────────────────────────────────────────
    // Format: results/{uid}_{examId}
    // User can read/write their own result; admin can read all
    match /results/{resultId} {
      allow read: if isAuth() && (
        resultId.matches(request.auth.uid + '_.*') || isAdmin()
      );
      allow write: if isAuth() && resultId.matches(request.auth.uid + '_.*');
    }

    // ── Attempts (full log) ────────────────────────────────────────────────
    // User can write their own; admin can read all
    match /attempts/{attemptId} {
      allow read: if isAuth() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ── Config ────────────────────────────────────────────────────────────
    // Public read (site name, pass mark); admin write
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Admins ────────────────────────────────────────────────────────────
    // Only existing admins can read/write this list
    match /admins/{uid} {
      allow read, write: if isAdmin();
    }
  }
}

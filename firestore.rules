// ==========================================================================
// Firestore Security Rules — "tvexam" PROJECT ONLY
// (Firebase Console → tvexam project → Firestore Database → Rules → paste this → Publish)
//
// IMPORTANT: "tvexam" is a separate Firebase project from "tv-course", with
// its own separate Authentication. request.auth here is ONLY populated
// because js/auth.js mirrors every login onto this project's own Auth
// (examAuth) — see ensureExamAuth() in js/auth.js. Every signed-in user
// (including admins) must have logged in at least once AFTER that code was
// deployed, or request.auth will be null and every rule below will block
// them. If someone reports "can't open exams" right after this update,
// have them sign out and sign back in once.
// ==========================================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Admins are listed by exact email (document ID = the admin's login
    // email, lowercase) in the /admins collection. Add one doc per admin
    // manually in the Firebase Console — see README "অ্যাডমিন সেটআপ".
    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // Never readable or writable by any client — only ever consulted
    // internally by isAdmin() above via exists(), which bypasses this rule.
    match /admins/{email} {
      allow read, write: if false;
    }

    match /exams/{examId} {
      allow read: if isSignedIn();

      // Only an admin can ever write here. Field checks only fire when the
      // field is actually present, so editing/duplicating older exam docs
      // that predate some field never breaks — but any field that IS sent
      // must have a sane type/value, so a tampered payload can't sneak in
      // (e.g. status set to something other than draft/published).
      allow create, update: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() < 300
        && request.resource.data.status in ["draft", "published"]
        && (!("duration" in request.resource.data) || request.resource.data.duration is number)
        && (!("negativeMarking" in request.resource.data) || request.resource.data.negativeMarking is number)
        && (!("maxAttempts" in request.resource.data) || request.resource.data.maxAttempts is number)
        && (!("passingPercent" in request.resource.data) || request.resource.data.passingPercent is number)
        && (!("shuffle" in request.resource.data) || request.resource.data.shuffle is bool)
        && (!("showAll" in request.resource.data) || request.resource.data.showAll is bool)
        && (!("questionCount" in request.resource.data) || request.resource.data.questionCount is number)
        && (!("totalMarks" in request.resource.data) || request.resource.data.totalMarks is number);

      allow delete: if isAdmin();

      match /questions/{questionId} {
        allow read: if isSignedIn();

        allow create, update: if isAdmin()
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.options is list
          && request.resource.data.options.size() >= 2
          && request.resource.data.options.size() <= 6
          && request.resource.data.correctIndex is int
          && request.resource.data.correctIndex >= 0
          && request.resource.data.correctIndex < request.resource.data.options.size()
          && (!("marks" in request.resource.data) || (request.resource.data.marks is number && request.resource.data.marks > 0));

        allow delete: if isAdmin();
      }
    }

    match /results/{resultId} {
      // Any signed-in user can read all results — required for the public
      // Leaderboard and for admin analytics. Individual result documents
      // don't contain anything more sensitive than name/email/score, which
      // is already shown on the Leaderboard by design.
      allow read: if isSignedIn();

      // A student can only ever create a result FOR THEMSELVES (their own
      // exam-project uid), never for anyone else, and the score fields must
      // be well-formed numbers in a sane range — this is what stops someone
      // from forging a 100% result via the browser console.
      allow create: if isSignedIn()
        && request.resource.data.examUid == request.auth.uid
        && request.resource.data.examId is string
        && request.resource.data.examId.size() > 0
        && request.resource.data.percent is number
        && request.resource.data.percent >= 0 && request.resource.data.percent <= 100
        && request.resource.data.correctCount is number && request.resource.data.correctCount >= 0
        && request.resource.data.wrongCount is number && request.resource.data.wrongCount >= 0
        && request.resource.data.unansweredCount is number && request.resource.data.unansweredCount >= 0
        && request.resource.data.timeTakenSeconds is number && request.resource.data.timeTakenSeconds >= 0
        && request.resource.data.studentEmail is string;

      // Results are immutable once submitted (matches how the app works —
      // every attempt is its own new document, never edited).
      allow update: if false;

      // Only an admin can delete a wrong/duplicate result.
      allow delete: if isAdmin();
    }
  }
}
